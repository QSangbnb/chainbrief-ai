# Your Orbio key. Claim it on orbio.so or through the Orbio MCP (orbio_claim_key).
# It is an OpenRouter key: one key, every model.
OPENROUTER_API_KEY=

# Required. Public Supabase project settings used for email/Google sign-in.
# Never use a service_role or secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional. Any model on openrouter.ai/models; `openrouter/auto` lets the router pick.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# Optional. Shown on OpenRouter's public rankings for your app.
APP_NAME=ChainBrief AI
APP_URL=http://localhost:5173

# Optional. Comma-separated signed-in email addresses allowed to open /api/admin/overview.
ADMIN_EMAILS=

# Optional. Maximum simultaneous paid OpenRouter requests.
PAID_CONCURRENCY_MAX=2

# Optional. When set, paid endpoints require this value in x-demo-access-code.
DEMO_ACCESS_CODE=
